{
  "name": "mock-fh5",
  "version": "0.0.556",
  "description": "prototype - simple REST api server with Forza Horizon 5 data...",
  "author": "eswat2",
  "repository": "eswat2/mock-fh5",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "dependencies": {
    "chance": "1.1.13",
    "nanoid": "6.0.1",
    "vin-generator": "1.0.1"
  },
  "devDependencies": {
    "bumpp": "12.2.2",
    "chai": "6.2.2",
    "cspell": "10.1.1",
    "env-cmd": "11.0.0",
    "mocha": "11.8.0",
    "only-allow": "1.2.2",
    "prettier": "3.9.6",
    "vercel": "59.9.1",
    "yoctocolors": "2.2.0"
  },
  "scripts": {
    "bump": "bumpp patch --commit --tag --push --yes",
    "deploy-app": "vc --prod",
    "release": "pnpm bump && pnpm build && pnpm test && pnpm deploy-app",
    "preinstall": "npx only-allow pnpm",
    "sample": "node sample.mjs",
    "dev": "env-cmd -x -- vc dev --listen 8082 --token \\$API_TOKEN",
    "dev:docker": "vc dev --local --listen 0.0.0.0:8082",
    "cc": "prettier --check api utils tests",
    "format": "prettier --write api utils tests",
    "spell": "cspell './**/*.js'",
    "test": "mocha ./tests/*.js",
    "build": "pnpm format",
    "open": "open https://mock-fh5.vercel.app",
    "cars": "open https://mock-fh5.vercel.app/api/cars",
    "solution": "open https://mock-fh5.vercel.app/api/solution"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  }
}
